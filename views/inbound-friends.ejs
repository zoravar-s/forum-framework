<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inbound Friends</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('includes/header') %>
    <main>
    <h3>Inbound Friend Requests</h3>
    <a href="/outbound-friends/page1">View Outbound Friend Requests</a>
    <ul>
        <% requests.forEach(request => { %>
            <p><b><a href="/profile/<%- request.friend1 %>/page1"><%= request.sender_username %></a></b> send a friend request to <b><%= request.recipient_username %></b> at <%- new Date(request.createdDate).toString() %></p>
            <form style="display: inline;" action="/add-friend/<%= request.friend1 %>" method="POST">
                <button>Accept Request</button>
            </form>
            <br>
            <% }) %>
        <% if (Number(pagenum) > 1) { %>
            <a href="/inbound-friends/page<%= Number(pagenum)-1%>">Previous page</a>
        <% } %>
        <% if (Math.ceil(requestsLength/10) > Number(pagenum)) { %>
            <a href="/inbound-friends/page<%= Number(pagenum)+1%>">Next page</a>
        <% } %>
    </ul>
    </main>
    <%- include('includes/footer') %>
</body>
</html>