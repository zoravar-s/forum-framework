<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('includes/header') %>
    <% errors.forEach(error =>{ %>
        <p class="notice"><%= error %></p>
    <% }) %>
    <main style="background-color: whitesmoke;">
        <table>
            <tr>
                <td style="position: sticky; top: 0; width: 60%;">
                        <h3><%= userIdentifier.username %></h3>
                        <% if (info.isAdmin == 1) { %>
                            <img src="/banhammer.png" alt="Banhammer" width="20" style="vertical-align: middle;"><small style="color: red;"><b>Administrator</b></small><br><br>
                        <% } %>    
                    <small>Joined <%= new Date(info.userJoin).toString() %></small><br><br>
                    <a href="/send-message/<%=userIdentifier.id%>"><button>Send Message</button></a>
                    <% if ((userIdentifier.id !== user.userid)&&(!ifFriends)) { %>
                        <form style="display: inline;" action="/add-friend/<%= userIdentifier.id %>" method="POST">
                            <button>Send Friend Request</button>
                        </form> 
                    <% } else { %> 
                        <% if ((typeof ifFriends !== "undefined")&&(ifFriends.status == 0)) { %>
                            <p style="display: inline;">Friend request pending</p>
                        <% } else if ((typeof ifFriends !== "undefined")) { %>   
                            <form style="display: inline;" action="/remove-friend/<%= userIdentifier.id %>" method="POST">
                                <button>Unfriend</button>
                            </form> 
                        <% } %> 
                    <% } %> 
                    <p><fieldset><legend><b>Bio:</b></legend><%-filterUserHTML(info.bio)%></fieldset></p>
                </td>
                <td>
                    <h3>Friends</h3>
                    <% friendsPreview.forEach(friend => { %>
                        <% if (userIdentifier.id == friend.friend2) { %>
                        <p><a href="/profile/<%= friend.friend1 %>/page1"><%= friend.senderuser %></a></p>
                        <% } else { %>
                        <p><a href="/profile/<%= friend.friend2 %>/page1"><%= friend.recipientuser %></a></p>
                        <% } %>
                    <% }) %>
                    <a href="/profile/<%=userIdentifier.id%>/friends/page1"><button>View All Friends</button></a>
                </td>
            </tr>
        </table>
    <p><b>Posts:</b></p>
    <ul>
        <% userposts.forEach(post => { %>
            <fieldset>
            <small><%= new Date(post.createdDate).toString() %></small>
            <p><b><%= post.title %></b></p>
            <p><%- filterUserHTML(post.body) %></p>
            <% if (post.likes == 1) { %>
                <small><%=post.likes%> like - </small>
            <% } else { %>   
                <small><%=post.likes%> likes - </small>
            <% } %>
            <small><a href="/post/<%= post.id %>">View full post</a></small>
            </fieldset>
        <% }) %>
        <% if (Number(pagenum) > 1) { %>
            <a href="/profile/<%= userIdentifier.id %>/page<%= Number(pagenum)-1 %>">Previous page</a>
        <% } %>
        <% if (Math.ceil(commentslength/10) > Number(pagenum)) { %>
            <a href="/profile/<%= userIdentifier.id %>/page<%= Number(pagenum)+1 %>">Next page</a>
        <% } %>
    </ul>
    </main>
    <%- include('includes/footer') %>
</body>
</html>