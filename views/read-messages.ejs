<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('includes/header') %>
    <main>
    <h3>Read Messages</h3>
    <ul>
        <a href="/messages/page1"><button>View unread messages</button></a><br><br>
        <% userMessages.forEach(post => { %>
            <fieldset>
            <small>From <%= post.sender_username %> on <%= new Date(post.createdDate).toString() %> to <%= post.recipient_username %></small>
            <p><b>Title:</b> <%=post.title %></p>
            <a href="/message/<%=post.id %>"><button>View full message</button></a>
            <% if (post.recipient_username == user.username) { %>
            <form style="display: inline;" action="/unread-message/<%= post.id %>" method="POST">
                <button>Unmark as Read</button>
            </form>
            <% } %>
            </fieldset>
        <% }) %>
        <% if (Number(pagenum) > 1) { %>
            <a href="/read-messages/page<%= Number(pagenum)-1%>">Previous page</a>
        <% } %>
        <% if (Math.ceil(commentslength/10) > Number(pagenum)) { %>
            <a href="/read-messages/page<%= Number(pagenum)+1%>">Next page</a>
        <% } %>
    </ul>
    </main>
    <%- include('includes/footer') %>
</body>
</html>