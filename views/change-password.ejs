<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('includes/header') %>
    <main>
        <form action="/change-password" method="POST">
        <% errors.forEach(error =>{ %>
            <p class="notice"><%= error %></p>
        <% }) %>
        <fieldset>
            <legend>Change Password</legend>
            <label for="password"><small>Current Password</small></label>
            <input type="password" id="password" name="password" autocomplete = "off">

            <label for="newpassword"><small>New Password</small></label>
            <input type="password" id="newpassword" name="newpassword" autocomplete = "off">
            <br><small>If successful, this action will sign you out of your current session.</small><br><br>
            <button>Change Password</button>
        </fieldset>
        </form>
    </main>
    <%- include('includes/footer') %>
</body>
</html>